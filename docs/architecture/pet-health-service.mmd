C4Component
    title Component diagram for Pet Health Service

    Person(owner, "Owner", "Owner Bearer JWT")
    System_Ext(opm, "Owner & Pet Manager", "Ownership, species, and Pet status")
    System_Ext(am, "Activity Manager", "Latest-weight reads and activity-duration writes")

    Container_Boundary(phs, "Pet Health Service") {
        Component(profile, "Health profile", "Owner-facing and service-facing", "Latest weight and recommended daily kilocalories")
        Component(metrics, "Health metrics", "Owner-facing and service-facing", "Weight, calories consumed, and activity duration history")
        Component(meals, "Meals", "Owner-facing", "Meal lifecycle and calories-consumed metric writes")
        Component(washes, "Washes and Wash schedule", "Owner-facing", "Wash lifecycle, recurring schedule, and next due")
        Component(medical, "Medical record", "Owner-facing", "Vet visits and Medications")
        ComponentDb(store, "Health store", "System of record", "Profiles, metrics, Meals, Washes, schedules, Vet visits, and Medications")

        Rel(profile, metrics, "Derives latest weight")
        Rel(meals, metrics, "Creates, corrects, and deletes calories-consumed metrics")
        Rel(profile, store, "Reads and writes")
        Rel(metrics, store, "Reads and writes")
        Rel(meals, store, "Reads and writes")
        Rel(washes, store, "Reads and writes")
        Rel(medical, store, "Reads and writes")
    }

    Rel(owner, profile, "Profile + Owner JWT")
    Rel(owner, metrics, "Metrics + Owner JWT")
    Rel(owner, meals, "Meals + Owner JWT")
    Rel(owner, washes, "Washes + Owner JWT")
    Rel(owner, medical, "Medical record + Owner JWT")
    Rel(profile, opm, "Identity/status + pet-health-service JWT", "synchronous")
    Rel(metrics, opm, "Identity/status + pet-health-service JWT", "synchronous")
    Rel(meals, opm, "Identity/status + pet-health-service JWT", "synchronous")
    Rel(washes, opm, "Identity/status + pet-health-service JWT", "synchronous")
    Rel(medical, opm, "Identity/status + pet-health-service JWT", "synchronous")
    Rel(am, profile, "Latest weight + activity-manager JWT", "synchronous")
    Rel(am, metrics, "Activity-duration sync + activity-manager JWT", "synchronous")

    UpdateLayoutConfig($c4ShapeInRow="3", $c4BoundaryInRow="1")
