%% Field names follow the OpenAPI specs in postman/specs (ADR-0021).
%% Pet Health Service has no spec yet; its fields follow docs/requirements/pet-health-service.md.
%% `+` fields appear on the wire. `-` fields are internal state that no API returns as an entity field.
classDiagram
    direction TB

    namespace OwnerPetManager {
        class Owner {
            +id
            +username
            +email
            -passwordHash
            +photo
            +petListVisibility
            +active
        }
        class Pet {
            +id
            +ownerId
            +name
            +species
            +breed
            +dateOfBirth
            +sex
            +photo
            +active
        }
        class PetSummary {
            +id
            +name
            +species
            +breed
            +dateOfBirth
            +sex
            +photo
        }
    }

    namespace PetHealthService {
        class HealthProfile {
            +petId
            +latestWeight
            +recommendedDailyKilocalories
            +kilocaloriesOverride
        }
        class HealthMetric {
            +id
            +petId
            +dimension
            +value
            +timestamp
            +activityId
        }
        class Meal {
            +id
            +petId
            +foodName
            +kilocalories
            +timestamp
            +brand
            +labels
            +notes
        }
        class Wash {
            +id
            +petId
            +timestamp
            +notes
        }
        class WashSchedule {
            +petId
            +startDate
            +intervalDays
        }
        class VetVisit {
            +id
            +petId
            +date
            +time
            +clinicName
            +reasonOrSummary
        }
        class Medication {
            +id
            +petId
            +drugName
            +dosageInstructions
            +start
            +end
            +vetVisitId
        }
        class MedicalRecord {
            <<view>>
        }
    }

    namespace ActivityManager {
        class ActivityType {
            +id
            +label
            +gpsCapable
            +calorieFactor
            +scope
            +softRetired
        }
        class Activity {
            +id
            +petId
            +activityTypeId
            +timestamp
            +durationMinutes
            +activityAmount
            +caloriesBurned
            +calorieOverride
            +notes
            +mediaRefs
            +route
        }
        class Share {
            +id
            +activityId
            +audience
            -revoked
        }
        class ShareSnapshot {
            <<view>>
            +petDisplayName
            +activityTypeLabel
            +timestamp
            +durationMinutes
            +caloriesBurned
            +activityAmount
            +notes
            +mediaRefs
            +route
        }
    }

    namespace AuthenticationService {
        class OwnerSession {
            -id
            -ownerId
            -issuedAt
            -expiresAt
        }
        class RefreshToken {
            -id
            -rotated
        }
        class PasswordReset {
            -id
            -ownerId
            -expiresAt
            -used
        }
        class PlatformClient {
            -serviceId
            -secretHash
            -active
        }
        class ClientCredentialsGrant {
            <<service>>
            +issuePlatformAccessToken()
        }
    }

    Owner "1" --> "*" Pet : manages
    Pet ..> PetSummary : public summary
    Pet ..> HealthProfile : petId
    HealthProfile "1" --> "*" HealthMetric : history
    Meal "1" --> "1" HealthMetric : calories-consumed
    Pet ..> Meal : petId
    Pet ..> Wash : petId
    Pet ..> WashSchedule : petId
    WashSchedule ..> Wash : next due
    Pet ..> VetVisit : petId
    Pet ..> Medication : petId
    MedicalRecord o-- VetVisit
    MedicalRecord o-- Medication
    Medication "0..1" --> "0..1" VetVisit : optional link
    Owner "0..1" --> "*" ActivityType : custom
    Pet ..> Activity : petId
    Activity "*" --> "1" ActivityType
    Activity "1" --> "1" HealthMetric : activity-duration
    Activity "1" --> "*" Share
    Share ..> ShareSnapshot : resolve
    Owner ..> OwnerSession : ownerId
    OwnerSession "1" --> "*" RefreshToken : rotation
    Owner ..> PasswordReset : ownerId
    ClientCredentialsGrant --> PlatformClient : authenticates against registry

    note for MedicalRecord "Vet visits and Medications together"
    note for Share "audience is owner (recipientOwnerId), forum (forumId), group-activity (groupActivityId), or external (link, summary)"
    note for OwnerSession "Access token is issued and not stored. Password hash is not copied."
    note for RefreshToken "Recognized until the Owner session ends. The secret is not stored."
    note for Activity "route is present if and only if the Activity type is GPS-capable (a GPS Activity)"
    note for ClientCredentialsGrant "Platform access token is issued and not stored"
