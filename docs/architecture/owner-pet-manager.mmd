C4Component
    title Component diagram for Owner & Pet Manager

    Person(owner, "Owner", "Create is public; other calls use Owner JWT")
    Person(otherOwner, "Another Owner", "Public Pet summaries only")
    System_Ext(phs, "Pet Health Service", "Pet identity and status")
    System_Ext(am, "Activity Manager", "Pet identity and status")
    System_Ext(auth, "Authentication Service", "Credentials read/set; revoke notices; JWT issuer")
    System_Ext(community, "Community collaborator", "Owner check (fail closed); end belonging (best effort); stub in local/CI")
    System_Ext(psa, "Platform-service authenticator", "Inbound JWT verify; outbound platform JWT")

    Container_Boundary(opm, "Owner & Pet Manager") {
        Component(http, "HTTP adapter", "Fastify", "Routes, allowlist, Problem Details mapping")
        Component(ownerC, "Owner", "Application", "Identity, visibility, Deactivation orchestration")
        Component(petC, "Pet", "Application", "Pet identity; one Owner per Pet")
        Component(summary, "Pet summary", "Application", "Public list and Get Pet Summary")
        Component(lookup, "Identity lookup", "Application", "Get, list, ownership check")
        Component(credentials, "Credentials", "Application", "Auth-only hash read and set-password")
        Component(passwordPolicy, "Password policy", "Application", "Length, local denylist; Argon2id at edge")
        ComponentDb(store, "Owner and Pet store", "PostgreSQL", "UUID v7 ids, uniqueness, Deactivation, visibility")

        Rel(http, ownerC, "Actor + command")
        Rel(http, petC, "Actor + command")
        Rel(http, summary, "Actor + query")
        Rel(http, lookup, "Actor + query")
        Rel(http, credentials, "Actor + command")
        Rel(ownerC, petC, "Deactivates active Pets first (same TX)")
        Rel(ownerC, passwordPolicy, "Create/update password")
        Rel(credentials, passwordPolicy, "Set-password from Auth")
        Rel(ownerC, store, "Reads and writes")
        Rel(petC, store, "Reads and writes")
        Rel(summary, store, "Reads")
        Rel(lookup, store, "Reads")
        Rel(credentials, store, "Reads and writes")
    }

    Rel(psa, http, "Trusted actor (ownerId or service)")
    Rel(owner, http, "Creates publicly; maintains with Owner JWT")
    Rel(otherOwner, http, "Public Pet summaries with Owner JWT")
    Rel(phs, http, "Lookup + pet-health-service JWT")
    Rel(am, http, "Lookup + activity-manager JWT")
    Rel(auth, http, "Credentials + authentication-service JWT", "synchronous")
    Rel(ownerC, auth, "Revoke after Deactivation or password change (best effort)", "synchronous")
    Rel(credentials, auth, "Revoke after set-password (best effort)", "synchronous")
    Rel(ownerC, community, "Community-owner check before writes (fail closed)", "synchronous")
    Rel(ownerC, community, "End belonging after Deactivation (best effort)", "synchronous")

    UpdateLayoutConfig($c4ShapeInRow="3", $c4BoundaryInRow="1")
